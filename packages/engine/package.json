{
  "name": "@problocks/engine",
  "version": "0.0.1",
  "private": true,
  "description": "Problocks simulation engine — 2D/3D rendering, physics, scripting sandbox",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./renderer/*": "./src/renderer/*.ts",
    "./physics/*": "./src/physics/*.ts",
    "./core/*": "./src/core/*.ts",
    "./scripting/*": "./src/scripting/*.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest"
  },
  "dependencies": {
    "@babylonjs/core": "^9.0.0",
    "@babylonjs/loaders": "^9.0.0",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "quickjs-emscripten": "^0.31.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
